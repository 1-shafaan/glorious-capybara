{
  "name": "codespaces-react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "description": "A focused desktop media library for downloaded films and series.",
  "author": "Flicker",
  "dependencies": {
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.4.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "web-vitals": "^3.1.0"
  },
  "overrides": {
    "@svgr/webpack": "^8.0.1",
    "@adobe/css-tools": "^4.3.1"
  },
  "scripts": {
    "start": "BROWSER=none WDS_SOCKET_PORT=0 vite --port 3000",
      "web": "vite --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "desktop": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win portable",
    "package:win:installer": "npm run build && electron-builder --win nsis",
    "package:linux": "npm run build && electron-builder --linux AppImage",
    "preview": "vite preview",
    "test": "vitest"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.12",
    "jsdom": "^26.1.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.6"
  },
  "build": {
    "appId": "com.flicker.media",
    "productName": "Flicker",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "publish": null,
    "win": {
      "target": "portable",
      "signAndEditExecutable": false,
      "artifactName": "Flicker-${version}-portable.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "category": "AudioVideo",
      "artifactName": "Flicker-${version}.${ext}"
    }
  }
}
